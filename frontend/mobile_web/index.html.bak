      <div class="card-clean p-4.5 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-emerald-100 flex items-center justify-center text-emerald-800">
            💧
          </div>
          <div>
            <div class="text-sm font-bold text-slate-900">Drip Fertigation System</div>
            <div class="text-xs text-emerald-700 font-bold">Active Cycle • Potassium Nitrate</div>
          </div>
        </div>
